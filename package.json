{
  "name": "nextflix-webos",
  "version": "2.0.0",
  "private": true,
  "description": "A lightweight Xtream live TV player for LG webOS",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build && node scripts/make-webos-classic.cjs",
    "package": "node scripts/package-public.cjs",
    "test:catalog": "node scripts/verify-catalog.cjs",
    "test:provider-storage": "node scripts/verify-provider-storage.cjs",
    "verify:backup": "node scripts/verify-backup.cjs",
    "verify:webos-service": "node scripts/verify-webos-service.cjs"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.8.3",
    "vite": "~6.3.5"
  }
}
